+/* ASYNC_HOST_NOTIFY: audio-side housekeeping only posts a bounded flag.
+ * Host UI callbacks may block; the display thread delivers the latest value. */
+static void notify_value(wrap_t *w, int i, float value) {
+    if (ASYNC_HOST_NOTIFY) __atomic_store_n(&w->notify_pending[i], 1, __ATOMIC_RELEASE);
+    else w->master(&w->fx, audioMasterAutomate, i, 0, 0, value);
+}
+static void notify_display(wrap_t *w) {
+    if (ASYNC_HOST_NOTIFY) __atomic_store_n(&w->notify_update, 1, __ATOMIC_RELEASE);
+    else w->master(&w->fx, audioMasterUpdateDisplay, 0, 0, 0, 0.0f);
+}
