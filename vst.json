{
  "name": "Geonkick MPC",
  "vendor": "OpenMPC",
  "uid": "GkM3",
  "version": 22,
  "so": "geonkick_mpc.so",
  "params": "params.json",
  "layout": "layout.conf",
  "targets": [
    "aarch64"
  ],
  "defines": {
    "ENGINE_FLOAT32": 1,
    "SAMPLE_ACCURATE": 1,
    "HAS_DISPLAY_REV": 1,
    "DISPLAY_REV_THREAD": 1,
    "DISPLAY_REV_NO_UPDATE": 1,
    "ASYNC_HOST_NOTIFY": 1,
    "LIVE_PARAMS_READONLY": 1,
    "GRAPH_UPDATE_IDLE_MS": 180,
    "FINE_INPUT_CONTINUOUS": 1,
    "GRAPH_INVALIDATION_ONLY": 1,
    "GRAPH_REBIND_ON_REFRESH": 1,
    "FINE_TRACK_RAW_INPUT": 1,
    "CANONICAL_CONTINUOUS_ECHO": 1,
    "ENGINE_CHUNK_CAPACITY": 1048576,
    "IDLE_ACTION_RELEASE": 1,
    "XY_POSITION_FEEDBACK": 1,
    "FILTER_CONTROL_FEEDBACK": 1,
    "CONTROL_CONTEXT_REV": 1
  },
  "programs": {
    "param": "preset"
  },
  "title_font": "art/DejaVuSans.ttf",
  "tile": "art/browser-tile.png",
  "build": {
    "root": ".",
    "sources": [
      "src/engine.c",
      "src/dsp/synthesizer.c",
      "src/dsp/oscillator.c",
      "src/dsp/envelope.c",
      "src/dsp/filter.c",
      "src/dsp/distortion.c",
      "src/dsp/gkick_buffer.c",
      "src/dsp/gkick_log.c",
      "src/dsp/audio_output.c",
      "src/dsp/ring_buffer.c",
      "src/dsp/humanizer.c"
    ],
    "cflags": [
      "-std=gnu11",
      "-Isrc/dsp",
      "-Isrc/dsp/quamplex_dsp_tools",
      "-DGEONKICK_VERSION_HEX=0x030900",
      "-DGEONKICK_OS_GNU"
    ],
    "libs": [
      "-lm",
      "-lpthread"
    ]
  }
}
